-- Загальна вартість всіх замовлень
SELECT SUM(products.price * orders.quantity) FROM orders
JOIN products ON orders.product_id = products.product_id;


-- Середній чек замовлення:
SELECT AVG(products.price * orders.quantity) AS avarage_sale
FROM orders
JOIN products ON orders.product_id = products.product_id;


-- Найбільш популярна категорія товарів:
SELECT products.category, SUM(orders.quantity) AS total_sales
FROM orders
JOIN products ON orders.product_id = products.product_id
GROUP BY products.category
ORDER BY total_sales DESC
LIMIT 3;

SELECT category, COUNT(product_id)
FROM products
GROUP BY category;

